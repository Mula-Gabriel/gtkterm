# Ports CDC des afficheurs Metro : un nom par appareil, numéroté par produit annoncé (P/N ou modèle : /dev/ttyM5SIN2_1, /dev/ttyF3_1...), et ModemManager tenu à l'écart
# (plus de « AT » envoyés aux consoles). Tout produit sur 1fc9:00b5 : un nouveau P/N n'oblige pas à retoucher la règle.
# Installée par ninja install (donc par la mise à jour de gtkterm) dans /etc/udev/rules.d, où elle remplace la version posée à la main.
SUBSYSTEM=="tty", ATTRS{idVendor}=="1fc9", ATTRS{idProduct}=="00b5", ENV{ID_MM_DEVICE_IGNORE}="1"
SUBSYSTEM=="tty", ACTION!="remove", ATTRS{idVendor}=="1fc9", ATTRS{idProduct}=="00b5", PROGRAM="@BINDIR@/metro-tty-index $attr{product} $devnode", SYMLINK+="tty%c"
