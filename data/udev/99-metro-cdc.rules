# Ports CDC des afficheurs Metro : un nom par appareil, numéroté par produit (/dev/ttyM5_1, /dev/ttyM5_2...), et ModemManager tenu à l'écart (plus de « AT » envoyés aux consoles).
# Installation : sudo install -m 644 99-metro-cdc.rules /etc/udev/rules.d/ && sudo install -m 755 metro-tty-index /usr/local/bin/ && sudo udevadm control --reload && sudo udevadm trigger -s tty
SUBSYSTEM=="tty", ATTRS{idVendor}=="1fc9", ATTRS{idProduct}=="00b5", ENV{ID_MM_DEVICE_IGNORE}="1"
SUBSYSTEM=="tty", ACTION!="remove", ATTRS{product}=="F1|F2|F3|M5|GD200|D65S|D75|IKM5|SUN_M5", PROGRAM="/usr/local/bin/metro-tty-index $attr{product} $devnode", SYMLINK+="tty$attr{product}_%c"
