msgstr "%s : [%s] limites d'arguments invalides supprimées"

#: src/macro_file.c:205
#, c-format
msgid "Unsupported macros file version (written by a newer GTKTerm?)"
msgstr ""
"Version de fichier de macros non prise en charge (écrit par une version plus "
"récente de GTKTerm ?)"

#. Des groupes, aucun de connu : fichier étranger refusé, jamais lu comme un jeu vide qui l'écraserait ensuite
#: src/macro_file.c:352
#, c-format
msgid "%s is not a GTKTerm macros file"
msgstr "%s n'est pas un fichier de macros de GTKTerm"

#: src/macro_file.c:409
#, c-format
msgid ""
"%s was not overwritten: it is not in the current macros format and its "
"backup %s already exists with a different content. Rename or delete %s, then "
"save again."
msgstr ""
"%s n'a pas été écrasé : il n'est pas au format actuel des macros et sa copie "
"%s existe déjà avec un contenu différent. Renommez ou supprimez %s, puis "
"enregistrez de nouveau."

#: src/macro_override.c:359
#, c-format
msgid "%s: [%s] %s: invalid value ignored"
msgstr "%s : [%s] %s : valeur invalide ignorée"

#: src/macro_override.c:496
#, c-format
msgid "%s: [%s] duplicates [%s]: the earlier group is ignored"
msgstr "%s : [%s] reprend [%s] : le groupe précédent est ignoré"

#: src/macros.c:178
#, c-format
msgid "Macro \"%s\" not sent: argument %d: %s"
msgstr "Macro « %s » non envoyée : argument %d : %s"

#: src/macros.c:192
#, c-format
msgid "Macro \"%s\" sent!"
msgstr "Macro « %s » envoyée !"

#. Profil (non interactif) : jeu vide, mais le chemin courant devient ce fichier. Les enregistrements suivants le visent
#. (gt_macro_file_save en garde d'abord une copie <fichier>.avant-migration), jamais le fichier par défaut, et le profil
#. n'est pas redirigé. Avertissement, plus une boîte différée : pas de boucle imbriquée pendant le chargement du profil,
#. et l'utilisateur sait que ses macros n'ont pas été lues.
#: src/macros.c:518 src/macros.c:533 src/macros.c:721 src/macros.c:907
#, c-format
msgid "Cannot load macros file: %s"
msgstr "Impossible de charger le fichier de macros : %s"

#: src/macros.c:573
msgid "This tab has no macros file: its macros are saved with the project."
msgstr ""
"Cet onglet n'a pas de fichier de macros : ses macros sont enregistrées avec "
"le projet."

#: src/macros.c:581
#, c-format
msgid "%s changed on disk: not overwritten"
msgstr "%s a changé sur le disque : non écrasé"

#: src/macros.c:595
#, c-format
msgid "%s already exists: not overwritten"
msgstr "%s existe déjà : non écrasé"

#: src/macros.c:608
#, c-format
msgid "Cannot save macros file: %s"
msgstr "Impossible d'enregistrer le fichier de macros : %s"

#. Le jeu effectif reste : les valeurs propres deviennent les valeurs de la copie
#: src/macros.c:794
#, c-format
msgid "Detached from macros template %s"
msgstr "Détaché du modèle de macros %s"

#: src/macros.c:861
#, c-format
