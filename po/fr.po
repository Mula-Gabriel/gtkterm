msgstr "Impossible d'enregistrer le modèle de macros : %s"

#: src/macros.c:872
#, c-format
msgid "Macros template %s saved"
msgstr "Modèle de macros %s enregistré"

#: src/port_form.c:76
msgid "Enter the serial port to open (for example /dev/ttyUSB0)."
msgstr "Saisissez le port série à ouvrir (par exemple /dev/ttyUSB0)."

#: src/port_form.c:81
#, c-format
msgid "The baud rate must be a whole number between 1 and %d."
msgstr "Le débit doit être un nombre entier compris entre 1 et %d."

#: src/port_form.c:86
msgid "Invalid number of data bits or stop bits."
msgstr "Nombre de bits de données ou de bits de stop non valide."

#: src/port_form.c:91 src/port_form.c:110
#, c-format
msgid "Delays must be between 0 and %d ms."
msgstr "Les délais doivent être compris entre 0 et %d ms."

#: src/port_form.c:99
msgid "Enter the host to connect to."
msgstr "Saisissez l'hôte auquel se connecter."

#: src/port_form.c:104
msgid "The TCP port must be a number between 1 and 65535."
msgstr "Le port TCP doit être un nombre compris entre 1 et 65535."

#: src/port_form.c:120
msgid "Enter the character to wait for: exactly one ASCII character."
msgstr ""
"Saisissez le caractère à attendre : un seul caractère ASCII exactement."

#: src/port_form.c:127
#, c-format
msgid "Activity delays must be between 0 and %d s."
msgstr "Les délais d'activité doivent être compris entre 0 et %d s."

#: src/profile.c:85
#, c-format
msgid "Baud rate %u may not be supported by all hardware"
msgstr "Le débit %u peut ne pas être pris en charge par tous les matériels"

#: src/profile.c:89
#, c-format
msgid ""
"Invalid number of stop-bits: %d\n"
"Falling back to default number of stop-bits number: %d\n"
msgstr ""
"Nombre de bits de stop impossible: %d\n"
"Retour au nombre de bits de stop par défaut: %d\n"

#: src/profile.c:96
#, c-format
msgid ""
"Invalid number of bits: %d\n"
"Falling back to default number of bits: %d\n"
msgstr ""
"Nombre de bits impossible: %d\n"
"Retour au nombre de bits par défaut: %d\n"

#: src/profile.c:102
#, c-format
msgid ""
"Invalid delay: %d ms\n"
"Falling back to default delay: %d ms\n"
msgstr ""
"Délai impossible: %d ms\n"
"Retour au délai par défaut: %d ms\n"

#: src/profile.c:108
#, c-format
msgid ""
"Invalid idle delay: %d s\n"
"Falling back to default idle delay: %d s\n"
msgstr ""
"Délai de repos impossible: %d s\n"
"Retour au délai de repos par défaut: %d s\n"

#: src/profile.c:114
#, c-format
msgid ""
"Invalid no data delay: %d s\n"
"Falling back to default no data delay: %d s\n"
msgstr ""
"Délai sans données impossible: %d s\n"
"Retour au délai sans données par défaut: %d s\n"

#: src/profile.c:156 src/profile.c:180
msgid ""
"The configuration name cannot contain \"[\", \"]\" or control characters."
msgstr ""
"Le nom de la configuration ne peut contenir ni « [ », ni « ] », ni caractère "
"de contrôle."

#: src/profile.c:162
msgid "The configuration name cannot be empty."
msgstr "Le nom de la configuration ne peut pas être vide."

#: src/profile.c:168
#, c-format
msgid "The configuration name is too long (%d characters at most)."
msgstr "Le nom de la configuration est trop long (%d caractères au plus)."

#: src/profile.c:188
#, c-format
