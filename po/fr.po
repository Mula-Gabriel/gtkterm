msgstr "Impossible de lire le fichier %s : ce n'est pas un fichier ordinaire"

#: src/file_sender.c:284 src/ui/file_actions.c:202
msgid "Error sending file"
msgstr "Erreur lors de l'envoi du fichier"

#: src/file_sender.c:292
msgid "File transfer cancelled"
msgstr "Envoi du fichier annulé"

