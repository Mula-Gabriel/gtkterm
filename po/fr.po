#. Des groupes, aucun de connu : fichier étranger refusé, jamais lu comme un jeu vide qui l'écraserait ensuite
#: src/macro_file.c:323
#, c-format
msgid "%s is not a GTKTerm macros file"
msgstr "%s n'est pas un fichier de macros de GTKTerm"

#: src/macro_file.c:380
#, c-format
msgid ""
"%s was not overwritten: it is not in the current macros format and its "
"backup %s already exists with a different content. Rename or delete %s, then "
"save again."
msgstr ""
"%s n'a pas été écrasé : il n'est pas au format actuel des macros et sa copie "
"%s existe déjà avec un contenu différent. Renommez ou supprimez %s, puis "
"enregistrez de nouveau."

#: src/macros.c:156
#, c-format
msgid "Macro \"%s\" sent!"
msgstr "Macro « %s » envoyée !"

#. Profil (non interactif) : jeu vide, mais le chemin courant devient ce fichier. Les enregistrements suivants le visent
#. (gt_macro_file_save en garde d'abord une copie <fichier>.avant-migration), jamais le fichier par défaut, et le profil
#. n'est pas redirigé. Avertissement, plus une boîte différée : pas de boucle imbriquée pendant le chargement du profil,
#. et l'utilisateur sait que ses macros n'ont pas été lues.
#: src/macros.c:379 src/macros.c:394
#, c-format
msgid "Cannot load macros file: %s"
msgstr "Impossible de charger le fichier de macros : %s"

#: src/macros.c:431
msgid "This tab has no macros file: its macros are saved with the project."
msgstr ""
"Cet onglet n'a pas de fichier de macros : ses macros sont enregistrées avec "
"le projet."

#: src/macros.c:439
#, c-format
msgid "%s changed on disk: not overwritten"
msgstr "%s a changé sur le disque : non écrasé"

