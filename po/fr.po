#: src/cmdline.c:61
#, c-format
msgid ""
"\n"
"GTKTerm version %s\n"
msgstr ""
"\n"
"GTKTerm version %s\n"

#: src/cmdline.c:62
msgid "\t (c) Julien Schmitt\n"
msgstr "\t (c) Julien Schmitt\n"

#: src/cmdline.c:63
msgid ""
"\n"
"This program is released under the terms of the GPL V.2\n"
msgstr ""
"\n"
"Ce programme est distribué selon les termes de la licence GPL V.2\n"

#: src/cmdline.c:64
msgid "\t ** Use at your own risks! **\n"
msgstr "\t ** Livré sans aucune garantie! **\n"

#: src/cmdline.c:65
msgid ""
"\n"
"Command line options\n"
msgstr ""
"\n"
"Options de la ligne de commande\n"

#: src/cmdline.c:66
msgid "--help or -h: this help screen\n"
msgstr "--help ou -h: cet écran d'aide\n"

#: src/cmdline.c:67
msgid "--config <configuration> or -c: load configuration\n"
msgstr "--config <configuration> ou -c: charger une configuration\n"

#: src/cmdline.c:68
msgid "--port <device> or -p: serial port device (default /dev/ttyS0)\n"
msgstr "--port <device> ou -p: device du port série (/dev/ttyS0 par défaut)\n"

#: src/cmdline.c:69
msgid "--speed <speed> or -s: serial port speed (default 9600)\n"
msgstr "--speed <speed> ou -s: vitesse du port série (9600 par défaut)\n"

#: src/cmdline.c:70
msgid "--bits <bits> or -b: number of bits (default 8)\n"
msgstr "--bits <bits> ou -b: nombre de bits (8 par défaut)\n"

#: src/cmdline.c:71
msgid "--stopbits <stopbits> or -t: number of stopbits (default 1)\n"
msgstr "--stopbits <stopbits> ou -t: nombre de bits de stop (1 par défaut)\n"

#: src/cmdline.c:72
msgid "--parity <none | odd | even> or -a: parity (default none)\n"
msgstr "--parity <none | odd | even> ou -a : parité (aucune par défaut)\n"

#: src/cmdline.c:73
msgid "--flow <none | Xon | RTS | RS485> or -w: flow control (default none)\n"
msgstr ""
"--flow <none | Xon | RTS | RS485> ou -w : contrôle de flux (aucun par "
"défaut)\n"

#: src/cmdline.c:74
msgid "--delay <ms> or -d: end of line delay in ms (default none)\n"
msgstr "--delay <ms> ou -d: délai de fin de ligne en ms (aucun par défaut)\n"

#: src/cmdline.c:75
msgid ""
"--char <char> or -r: wait for a special char at end of line (default none)\n"
msgstr ""
"--char <char> ou -r: caractère spécial à attendre en fin de ligne (aucun par "
"défaut)\n"

#: src/cmdline.c:76
msgid "--file <filename> or -f: default file to send (default none)\n"
msgstr ""
"--file <filename> ou -f: fichier par défaut à envoyer (aucun par défaut)\n"

#: src/cmdline.c:77
msgid ""
"--rts_time_before <ms> or -x: for RS-485, time in ms before transmit with "
"rts on\n"
msgstr ""
"--rts_time_before <ms> ou -x: pour RS-485, temps en ms avant transmission "
"avec rts activé\n"

#: src/cmdline.c:78
msgid ""
"--rts_time_after <ms> or -y: for RS-485, time in ms after transmit with rts "
"on\n"
msgstr ""
"--rts_time_after <ms> ou -y: pour RS-485, temps en ms après transmission "
"avec rts activé\n"

#: src/cmdline.c:79
msgid "--echo or -e: switch on local echo\n"
msgstr "--echo ou -e: écho local\n"

#: src/cmdline.c:80
msgid ""
"--disable-port-lock or -L: does not lock serial port. Allows to send to "
"serial port from different terminals\n"
msgstr ""
"--disable-port-lock ou -L : ne verrouille pas le port série. Permet "
"d'envoyer sur le port série depuis plusieurs terminaux\n"

#: src/cmdline.c:81
msgid ""
"                      Note: incoming data are displayed randomly on only one "
"terminal\n"
msgstr ""
"                      Remarque : les données reçues ne s'affichent, de façon "
"aléatoire, que sur un seul terminal\n"

#: src/cmdline.c:82
msgid "--transport <serial|tcp-client|tcp-server> or -T: transport type\n"
msgstr "--transport <serial|tcp-client|tcp-server> ou -T : type de transport\n"

#: src/cmdline.c:83
msgid "--host <hostname> or -H: TCP host\n"
msgstr "--host <nom d'hôte> ou -H : hôte TCP\n"

#: src/cmdline.c:84
msgid "--tcp-port <port> or -P: TCP port\n"
msgstr "--tcp-port <port> ou -P : port TCP\n"

#: src/cmdline.c:85
msgid "--project <file>: open this project\n"
msgstr "--project <fichier> : ouvre ce projet\n"

#: src/cmdline.c:102
#, c-format
msgid "Invalid value for option %s: \"%s\""
msgstr "Valeur non valide pour l'option %s : « %s »"

#: src/cmdline.c:222
#, c-format
msgid "Missing value for option %s"
msgstr "Valeur manquante pour l'option %s"

#. Élément fautif tel qu'écrit (« --nimporte », « -Z », « --echo=1 »)
#: src/cmdline.c:227
#, c-format
msgid "Unknown command line option: %s"
msgstr "Option de ligne de commande inconnue : %s"

#: src/cmdline.c:235
msgid "--project cannot be combined with --config or port settings"
msgstr ""
"--project ne peut pas être combiné avec --config ni avec des réglages de port"

#: src/config_store.c:586
#, c-format
msgid ""
"The configuration file %s could not be read: nothing has been written to it."
msgstr ""
"Le fichier de configuration %s n'a pas pu être lu : rien n'y a été écrit."

#: src/config_store.c:595
#, c-format
msgid "Cannot create directory %s: %s"
msgstr "Impossible de créer le dossier %s : %s"

